@Callable(i)
func startBreeding (refererAddress) = if (if ((size(i.payments) != 4))
    then (size(i.payments) != 3)
    else false)
    then throw("Wrong amount of payments!")
    else {
        let feeValidate = checkAdditionalPayment(i.payments[0])
        if ((feeValidate == feeValidate))
            then {
                let firstPayment = value(i.payments[1])
                let secondPayment = value(i.payments[2])
                let amountPaidByCoupons = {
                    let @ = invoke(getCouponsAddress(), "useCoupons", [getCanineIncubationFee()], nil)
                    if ($isInstanceOf(@, "Int"))
                        then @
                        else throw("Couldn't cast Any to Int")
                    }
                if ((amountPaidByCoupons == amountPaidByCoupons))
                    then {
                        let leftToPay = (getCanineIncubationFee() - amountPaidByCoupons)
                        if (if ((leftToPay == 0))
                            then (size(i.payments) == 4)
                            else false)
                            then throw("You need to attach 3 payments")
                            else {
                                let payment = if ((leftToPay != 0))
                                    then {
                                        let thirdPayment = value(i.payments[3])
                                        if ((thirdPayment.assetId != getEggAssetId()))
                                            then throw(("TB: You can attach only EGG tokens with the following asset id: " + toBase58String(getEggAssetId())))
                                            else if ((thirdPayment.amount != leftToPay))
                                                then throw(((("TB: To breed a Turtle you following amount of EGGlets: " + toString(leftToPay)) + " ") + toString(i.caller)))
                                                else {
                                                    let refererRewardForbeach = fraction(leftToPay, 5, 100)
                                                    let refCall = asBoolean(invoke(getRefContractAddress(), "refPayment", [refererAddress], [AttachedPayment(getEggAssetId(), refererRewardForbeach)]))
                                                    if ((refCall == refCall))
                                                        then {
                                                            let toBurn = if (refCall)
                                                                then (leftToPay - refererRewardForbeach)
                                                                else leftToPay
                                                            let burnCall = invoke(getBurnAddress(), "burnAttachedPayments", nil, [AttachedPayment(getEggAssetId(), toBurn)])
                                                            if ((burnCall == burnCall))
                                                                then leftToPay
                                                                else throw("Strict value is not equal to itself.")
                                                            }
                                                        else throw("Strict value is not equal to itself.")
                                                    }
                                        }
                                    else 0
                                if ((payment == payment))
                                    then {
                                        let firstAssetId = toBase58String(value(firstPayment.assetId))
                                        let secondAssetId = toBase58String(value(secondPayment.assetId))
                                        if (if ((firstPayment.amount != 1))
                                            then true
                                            else (secondPayment.amount != 1))
                                            then throw("NFT is not attached")
                                            else if (!(if (checkAssetInIncubator(firstAssetId))
                                                then checkAssetInIncubator(secondAssetId)
                                                else false))
                                                then throw("You need to attach 2 valid NFT-canines.")
                                                else if (if ((tryGetInteger((("asset_" + firstAssetId) + "_children")) > 0))
                                                    then true
                                                    else (tryGetInteger((("asset_" + secondAssetId) + "_children")) > 0))
                                                    then throw("One canine can be used for breeding only once in its lifetime.")
                                                    else {
                                                        let breededStatus = canBeBreeded(fromBase58String(firstAssetId), fromBase58String(secondAssetId))
                                                        if ((breededStatus != "true"))
                                                            then throw(("These canines cannot be breeded: " + breededStatus))
                                                            else ([StringEntry(getParentKey(i.transactionId, 1), firstAssetId), StringEntry(getParentKey(i.transactionId, 2), secondAssetId), StringEntry(getProcessStatusKey(toString(i.caller), i.transactionId), HatchingStarted), IntegerEntry(getProcessFinishHeightKey(toString(i.caller), i.transactionId), (height + delayForHatching))] ++ feeValidate)
                                                        }
                                        }
                                    else throw("Strict value is not equal to itself.")
                                }
                        }
                    else throw("Strict value is not equal to itself.")
                }
            else throw("Strict value is not equal to itself.")
        }



@Callable(i)
func finishHatching (txIdStr) = if ((size(i.payments) != 1))
    then throw("Wrong amount of payments!")
    else {
        let feeValidate = checkAdditionalPayment(i.payments[0])
        if ((feeValidate == feeValidate))
            then (finishHatchingInternal(txIdStr, i, 0, 0, "", 0) ++ feeValidate)
            else throw("Strict value is not equal to itself.")
        }



@Callable(i)
func fixedGene (txIdStr,parentFixedGene,positionFixedGene) = {
    let feeValidate = checkAdditionalPayment(i.payments[1])
    if ((feeValidate == feeValidate))
        then if (if ((parentFixedGene != 1))
            then (parentFixedGene != 2)
            else false)
            then throw("FG: Parent fixed gene can be only 1 or 2")
            else {
                let firstPayment = value(i.payments[0])
                if ((firstPayment.amount != 1))
                    then throw("NFT is not attached")
                    else {
                        let artefact = {
                            let @ = invoke(getItemsAddress(), "checkArtefactDetails", [toBase58String(value(firstPayment.assetId))], nil)
                            if ($isInstanceOf(@, "String"))
                                then @
                                else throw("Couldn't cast Any to String")
                            }
                        if ((artefact == artefact))
                            then if ((artefact != "ART-FIXGENE"))
                                then throw("You need to attach a ART-FIXGENE artefact")
                                else ((finishHatchingInternal(txIdStr, i, parentFixedGene, positionFixedGene, "", 0) ++ feeValidate) ++ [Burn(value(firstPayment.assetId), 1)])
                            else throw("Strict value is not equal to itself.")
                        }
                }
        else throw("Strict value is not equal to itself.")
    }



@Callable(i)
func freeGene (txIdStr) = {
    let feeValidate = checkAdditionalPayment(i.payments[1])
    if ((feeValidate == feeValidate))
        then {
            let firstPayment = value(i.payments[0])
            if ((firstPayment.amount != 1))
                then throw("NFT is not attached")
                else {
                    let artefact = {
                        let @ = invoke(getItemsAddress(), "checkArtefactDetails", [toBase58String(value(firstPayment.assetId))], nil)
                        if ($isInstanceOf(@, "String"))
                            then @
                            else throw("Couldn't cast Any to String")
                        }
                    if ((artefact == artefact))
                        then if ((artefact != "ART-FREEGENE"))
                            then throw("You need to attach a ART-FREEGENE artefact")
                            else {
                                let finishHeightKey = getProcessFinishHeightKey(toString(i.caller), fromBase58String(txIdStr))
                                let processFinishHeight = getIntegerValue(this, finishHeightKey)
                                let selectedGene = getRandomOldGenes(fromBase58String(txIdStr), processFinishHeight)
                                let randomPosition = getRandomNumber(8, fromBase58String(txIdStr), processFinishHeight, 3)
                                ((finishHatchingInternal(txIdStr, i, 0, 0, selectedGene, randomPosition) ++ feeValidate) ++ [Burn(value(firstPayment.assetId), 1)])
                                }
                        else throw("Strict value is not equal to itself.")
                    }
            }
        else throw("Strict value is not equal to itself.")
    }



@Callable(i)
func configureOracle (oracle) = if ((i.caller != this))
    then throw("ICU: admin only")
    else [StringEntry("static_oracleAddress", oracle)]


@Verifier(tx)
func verify () = if (isTestEnv())
    then sigVerify(tx.bodyBytes, tx.proofs[0], tx.senderPublicKey)
    else {
        let firstUser = base58'6TdaXEfhnjYquvPf3yV7MFxt2CbgFmaqsvGwkKfXtKi4'
        let secondUser = base58'7DsP2WaMLocbHuUxux7pbXRjTrrZ1TFQPsi5QumS3gr8'
        let thirdUser = base58'BpFWP3p3JgYrrP45xfrKzeMcWMEXoinj4FVPPkUiA8D3'
        let firstUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], firstUser))
            then 1
            else if (sigVerify(tx.bodyBytes, tx.proofs[1], firstUser))
                then 1
                else if (sigVerify(tx.bodyBytes, tx.proofs[2], firstUser))
                    then 1
                    else 0
        let secondUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], secondUser))
            then 1
            else if (sigVerify(tx.bodyBytes, tx.proofs[1], secondUser))
                then 1
                else if (sigVerify(tx.bodyBytes, tx.proofs[2], secondUser))
                    then 1
                    else 0
        let thirdUserSigned = if (sigVerify(tx.bodyBytes, tx.proofs[0], thirdUser))
            then 1
            else if (sigVerify(tx.bodyBytes, tx.proofs[1], thirdUser))
                then 1
                else if (sigVerify(tx.bodyBytes, tx.proofs[2], thirdUser))
                    then 1
                    else 0
        let signaturesCount = ((firstUserSigned + secondUserSigned) + thirdUserSigned)
        match tx {
            case _ => 
                (signaturesCount >= 1)
        }
        }
