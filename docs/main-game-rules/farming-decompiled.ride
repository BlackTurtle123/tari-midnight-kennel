let stakeId = tryGetString("last_stake_id")

let RefererReward = 5

func checkAdditionalPayment (payment) = if (isDefined(payment.assetId))
    then throw("FCAP: Please attach waves")
    else {
        let feeAmount = getIntegerValue(getOracle(), staticKey_extraFee())
        if ((payment.amount != feeAmount))
            then throw((("FCAP: Please attach exactly " + toString(feeAmount)) + " amount of wavelets"))
            else [ScriptTransfer(getFeeAggregator(), feeAmount, unit)]
        }


func tryGetInteger (key) = match getInteger(this, key) {
    case b: Int => 
        b
    case _ => 
        0
}


