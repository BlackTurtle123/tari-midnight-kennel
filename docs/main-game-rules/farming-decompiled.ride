let startTsMs = 1747612799000

func calculateDaysSinceStart () = {
    let diff = (lastBlock.timestamp - startTsMs)
    let daysPassed = (diff / (86400 * 1000))
    daysPassed
    }


func getBool (key) = match getBoolean(this, key) {
    case b: Boolean => 
        b
    case _ => 
        false
}


func isTestEnv () = getBool("TESTENV")


let Scale = 100000000

func tryGetStringExternal (address,key) = match getString(address, key) {
    case a: String => 
