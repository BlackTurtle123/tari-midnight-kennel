    case string: String => 
        string
    case _ => 
        throw("FAS: wrong type, expected: String")
}


func isProxyStakingSc (address) = {
    let allowedContracts = getProxyStaking()
    let allowedContractsList = split(allowedContracts, ";")
    (indexOf(allowedContractsList, address) != unit)
    }


