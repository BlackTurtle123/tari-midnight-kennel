        else false)
        then throw("IRR: admin or rebirth only")
        else {
            let duckGen = value(assetInfo(asset)).name
            let farmGen = getAssetFarmGen(assetId, duckGen)
[IntegerEntry(getCANIStatsKey(duckGen), (tryGetInteger(getCANIStatsKey(duckGen)) + 1)), IntegerEntry((("stats_" + farmGen) + "_quantity"), (tryGetInteger((("stats_" + farmGen) + "_quantity")) + 1))]
            }
    }



@Callable(i)
