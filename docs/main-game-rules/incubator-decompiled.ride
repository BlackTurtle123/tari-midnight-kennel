func getBool (key) = match getBoolean(this, key) {
    case b: Boolean => 
        b
    case _ => 
        false
}


func isTestEnv () = getBool("TESTENV")


func tryGetStringExternal (address,key) = match getString(address, key) {
    case a: String => 
        a
    case _ => 
        ""
}


func tryGetString (key) = tryGetStringExternal(this, key)


func staticKey_oracleAddress () = "static_oracleAddress"


func staticKey_extraFee () = "static_extraFee"


func staticKey_feeAggregator () = "static_feeAggregator"


func staticKey_caniRebirthAddress () = "static_canineRebirthAddress"


func staticKey_caniFarmingAddress () = "static_canineStakingAddress"


func staticKey_itemsAddress () = "static_itemsAddress"


func staticKey_rebirthAddress () = "static_rebirthAddress"


func staticKey_eagleRebirthAddress () = "static_eagleRebirthAddress"


func getOracle () = Address(fromBase58String(tryGetString(staticKey_oracleAddress())))


func getFeeAggregator () = Address(fromBase58String(tryGetStringExternal(getOracle(), staticKey_feeAggregator())))


func getMintAssetId () = unit


func getCaniRebirthAddress () = Address(fromBase58String(tryGetStringExternal(getOracle(), staticKey_caniRebirthAddress())))


func getDuckRebirthAddress () = Address(fromBase58String(tryGetStringExternal(getOracle(), staticKey_rebirthAddress())))


func getEagleRebirthAddress () = Address(fromBase58String(tryGetStringExternal(getOracle(), staticKey_eagleRebirthAddress())))


