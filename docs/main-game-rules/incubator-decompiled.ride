func getCouponsAddress () = Address(fromBase58String(tryGetStringExternal(getOracle(), "static_couponsAddress")))


func checkAdditionalPayment (payment) = if (isDefined(payment.assetId))
    then throw("BDCAP: Please attach waves")
    else {
        let feeAmount = getIntegerValue(getOracle(), staticKey_extraFee())
        if ((payment.amount != feeAmount))
            then throw((("BDCAP: Please attach exactly " + toString(feeAmount)) + " amount of wavelets"))
            else [ScriptTransfer(getFeeAggregator(), feeAmount, unit)]
        }


let delayForHatching = 2

let HatchingStarted = "HATCHING_STARTED"

let HatchingFinished = "HATCHING_FINISHED"

func isLocked () = {
    let masterAddress = Address(base58'3PEPftf2kWZDmAaWBjs6BUJa9957kiA2PkU')
    match getInteger(masterAddress, "egglock") {
        case b: Int => 
            b
        case _ => 
            0
    }
    }


func getHatchingStatusKey (address,txId) = (((address + "_") + toBase58String(txId)) + "_status")


func getHatchingFinishHeightKey (address,txId) = (((address + "_") + toBase58String(txId)) + "_fh")


func getCANIIdKey (address,txId) = (((address + "_") + toBase58String(txId)) + "_di")


func getCANIStatsKey (genString) = (("stats_" + genString) + "_amount")


func tryGetInteger (key) = {
    let val =     match getInteger(this, key) {
        case b: Int => 
            b
        case _ => 
            0
    }
    val
    }


let discountCoefficient = tryGetInteger("discountCoefficient")

func getRandomNumber (variants,txId,hatchingFinishHeight,offset) = {
    let randomSeedBlock = value(blockInfoByHeight((hatchingFinishHeight - 1)))
    let randomHash = sha256((txId + value(randomSeedBlock.vrf)))
    (toInt(randomHash, (offset * 8)) % variants)
    }


func bonusItemOutput (action,owner,initialTx,finishHeight) = {
    let key = ((("bonus_item_" + toString(this)) + "_") + action)
    let encoded = tryGetStringExternal(getOracle(), key)
    let chance = valueOrElse(getInteger(getOracle(), (key + "_chance")), 0)
    if (if ((encoded == ""))
        then true
        else (chance == 0))
        then nil
        else {
            let items = split(encoded, ",")
            if (if (if ((0 > chance))
                then true
                else (chance > 100))
                then true
                else (size(items) > 2))
                then throw("BONUS_CONFIG")
                else if (if ((getIntegerValue(getOracle(), (key + "_start")) > lastBlock.timestamp))
                    then true
                    else (lastBlock.timestamp >= getIntegerValue(getOracle(), (key + "_end"))))
                    then nil
                    else {
                        let seed = ((toBytes(("bonus|" + action)) + this.bytes) + fromBase58String(initialTx))
                        let random = getRandomNumber(200, seed, finishHeight, 0)
                        let resultKey = ((("address_" + owner) + "_initTx_") + initialTx)
                        let result = [IntegerEntry((resultKey + "_bonusRandom"), (random % 100))]
                        if (((random % 100) >= chance))
                            then result
                            else {
                                let item = items[if ((size(items) == 2))
                                    then (random / 100)
                                    else 0]
                                let bonus = {
                                    let @ = invoke(getItemsAddress(), "issueArtefactIndex", [item, owner, 2], nil)
                                    if ($isInstanceOf(@, "String"))
                                        then @
                                        else throw(($getType(@) + " couldn't be cast to String"))
                                    }
                                if ((bonus == bonus))
                                    then (result ++ [StringEntry((resultKey + "_bonusItem"), bonus)])
                                    else throw("Strict value is not equal to itself.")
                                }
                        }
            }
    }


func select (color) = {
    let oldGenes = [$Tuple2(("CANI-AAAAAAAA-G" + color), "8A-G"), $Tuple2(("CANI-BBBBBBBB-G" + color), "8B-G"), $Tuple2(("CANI-CCCCCCCC-G" + color), "8C-G"), $Tuple2(("CANI-DDDDDDDD-G" + color), "8D-G")]
    let newGenes = [$Tuple2(("CANI-EEEEEEEE-G" + color), "8E-G"), $Tuple2(("CANI-FFFFFFFF-G" + color), "8F-G"), $Tuple2(("CANI-GGGGGGGG-G" + color), "8G-G"), $Tuple2(("CANI-HHHHHHHH-G" + color), "8H-G")]
    $Tuple2((oldGenes ++ newGenes), newGenes)
    }


func getRandomName (txId,hatchingFinishHeight,all) = {
    let jackpotRandom = getRandomNumber(250, txId, hatchingFinishHeight, 1)
    let entry = IntegerEntry("last_jackpot_random", jackpotRandom)
    let colorRandom = getRandomNumber(4, txId, hatchingFinishHeight, 1)
    let color = ["A", "B", "C", "D"][colorRandom]
    let colorSelect = select(color)
    let toPickFrom = if (all)
        then colorSelect._1
        else colorSelect._2
    let typeRandom = getRandomNumber(size(toPickFrom), txId, hatchingFinishHeight, 0)
toPickFrom[typeRandom]
    }


let typesAmount = (size(select("R")._2) - 1)

func countEggsNeededAmount (totalCANIsAmount) = {
    let n = totalCANIsAmount
    let g = discountCoefficient
    let t = typesAmount
    let price = (pow((100 + ((n * g) / (10 * t))), 2, 5, 1, 2, DOWN) + 55)
    (price * 1500000)
    }


func getIncubatorFarmGen (assetName) = if ((takeRight(assetName, 2) == "JU"))
    then value(getString(getOracle(), ("farm_gen_" + assetName)))
    else (("8" + takeRight(take(assetName, 6), 1)) + "-G")


func getAssetFarmGen (assetId,assetName) = if ((takeRight(assetName, 2) != "JU"))
    then getIncubatorFarmGen(assetName)
    else {
        let recorded = getString(this, (("asset_" + assetId) + "_farmGen"))
        if (isDefined(recorded))
            then value(recorded)
            else {
                let historical = getString(getOracle(), ("farm_gen_asset_" + assetId))
                if (isDefined(historical))
                    then value(historical)
                    else getIncubatorFarmGen(assetName)
                }
        }


@Callable(i)
func reduceRarity (assetId,fGen) = {
    let asset = fromBase58String(assetId)
    if (if (if ((i.caller != getCaniRebirthAddress()))
        then (i.caller != getCouponsAddress())
        else false)
        then (i.caller != this)
        else false)
        then throw("IRR: admin, coupons or rebirth only")
        else {
            let duckGen = value(assetInfo(asset)).name
            let farmGen = getAssetFarmGen(assetId, duckGen)
[IntegerEntry(getCANIStatsKey(duckGen), (tryGetInteger(getCANIStatsKey(duckGen)) - 1)), IntegerEntry((("stats_" + farmGen) + "_quantity"), (tryGetInteger((("stats_" + farmGen) + "_quantity")) - 1))]
            }
    }



